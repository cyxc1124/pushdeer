FROM php:8.4.27-fpm-bookworm@sha256:1b6bb4f3d32dfbcd1e159d7bd47caa8852507f61666db7731d73f34acec781b6 AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends apache2 supervisor unzip \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql bcmath \
    && pecl install redis-6.3.0 \
    && docker-php-ext-enable redis \
    && a2enmod proxy_fcgi rewrite headers \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY --from=composer:2.11.0@sha256:278dfc7bd35169965d03f87194816f43bf4e6b6ea61707c2114e52ad12fe24ce /usr/bin/composer /usr/local/bin/composer
COPY docker/web/api-php.ini /usr/local/etc/php/conf.d/zz-pushdeer.ini
COPY docker/web/api-fpm.conf /usr/local/etc/php-fpm.d/zz-pushdeer.conf
COPY docker/web/api-apache.conf /etc/apache2/sites-available/000-default.conf
COPY docker/web/api-supervisord.conf /etc/supervisor/pushdeer.conf
COPY --chmod=755 docker/web/api-entrypoint.sh /usr/local/bin/pushdeer-entrypoint

WORKDIR /app/api

FROM base AS dependencies
COPY api/composer.json api/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY api ./
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --no-scripts --optimize \
    && php artisan package:discover --ansi \
    && chown -R www-data:www-data storage bootstrap/cache

FROM dependencies AS test
RUN composer install --no-scripts --prefer-dist --no-interaction \
    && php artisan package:discover --ansi
CMD ["vendor/bin/phpunit", "--stderr"]

FROM base AS api
COPY --from=dependencies /app/api /app/api
EXPOSE 80
ENTRYPOINT ["pushdeer-entrypoint"]
CMD ["supervisord", "--configuration", "/etc/supervisor/pushdeer.conf"]

FROM api AS self-hosted
COPY --chmod=755 docker/web/gorush /data/gorush
COPY push /app/push
COPY docker/web/supervisord-ios.conf /etc/supervisor/conf.d/push-ios.conf
COPY docker/web/supervisord-clip.conf /etc/supervisor/conf.d/push-clip.conf

FROM api AS runtime
